APP_ENV=development
APP_NAME=Python Practice PoC
DEMO_LOGIN_NAME=demo
MAX_SOURCE_CODE_LENGTH=20000
DATABASE_URL=postgresql+psycopg://python_poc:python_poc@db:5432/python_poc
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
POSTGRES_DB=python_poc
POSTGRES_USER=python_poc
POSTGRES_PASSWORD=python_poc
JUDGE0_BASE_URL=http://judge0:2358
# Lấy language ID Python thực tế từ GET /languages của instance Judge0.
JUDGE0_LANGUAGE_ID=
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_USER=
JUDGE0_POLL_INTERVAL_SECONDS=0.5
JUDGE0_POLL_TIMEOUT_SECONDS=15
JUDGE0_CPU_TIME_LIMIT_SECONDS=5
JUDGE0_WALL_TIME_LIMIT_SECONDS=10
JUDGE0_MEMORY_LIMIT_KB=256000
JUDGE0_MAX_FILE_SIZE_KB=1024
GRADING_STALE_RUN_TIMEOUT_SECONDS=180

# Cấu hình Hạn mức & Gợi ý KM/KH (Mục 2.4 & 2.5 Chương 2)
HINT_MAX_QUOTA=3
HINT_COOLDOWN_SECONDS=120
HINT_REQUEST_EXPIRE_SECONDS=60
HINT_MAX_EVIDENCE=2
HINT_MAX_RETRIES=2
HINT_ALLOW_HIDDEN_ONLY=false

# Cấu hình Module LLM Phản hồi Sư phạm (api_demo | colab_qwen | fake | disabled)
LLM_MODE=api_demo
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_ID=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=400
COLAB_QWEN_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
COLAB_QWEN_ENDPOINT_URL=
COLAB_QWEN_API_KEY=
GUARDRAIL_TOKEN_OVERLAP_THRESHOLD=0.75
